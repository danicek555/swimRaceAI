# Copy this file to .env and paste your key:
#   cp .env.example .env
#
# Get a key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional vision model for leave-block (Chat Completions + image input).
# Uncomment ONE line. Default in main.py if unset: gpt-4o
#
# --- cheaper / faster ---
# SWIM_VLM_MODEL=gpt-4o-mini
# SWIM_VLM_MODEL=gpt-4.1-mini
# SWIM_VLM_MODEL=gpt-4.1-nano
# SWIM_VLM_MODEL=gpt-5-mini
# SWIM_VLM_MODEL=gpt-5.4-mini
# SWIM_VLM_MODEL=gpt-5.6-luna
#
# --- strong (good next step from gpt-4o) ---
# SWIM_VLM_MODEL=gpt-4o
# SWIM_VLM_MODEL=gpt-4.1
# SWIM_VLM_MODEL=gpt-5.2
# SWIM_VLM_MODEL=gpt-5.4
# SWIM_VLM_MODEL=gpt-5.6-terra
#
# --- strongest / most expensive (try only if 4.1 / 5.4 still miss toes) ---
# SWIM_VLM_MODEL=gpt-5.5
# SWIM_VLM_MODEL=gpt-5.6-sol
# SWIM_VLM_MODEL=gpt-5.4-pro
# SWIM_VLM_MODEL=gpt-5.5-pro
#
# OPENAI_BASE_URL=https://api.openai.com/v1
